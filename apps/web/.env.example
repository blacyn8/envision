# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── TMDB ─────────────────────────────────────────────────────────────────────
# Get from: https://www.themoviedb.org/settings/api
# Free account gives you a key instantly
TMDB_API_KEY=your-tmdb-api-key-here

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Price IDs for the subscription tiers (from Stripe dashboard → Products)
STRIPE_PRICE_PREMIUM_MONTHLY=price_your-premium-price-id
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-price-id

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret checked against the `Authorization: Bearer` header on
# /api/cron/* routes. Vercel Cron sends this automatically when set as a
# project env var; generate any long random string.
CRON_SECRET=your-cron-secret-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
